generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nome        String
  cpf_cnpj    String?
  telefone    String?
  email       String?
  endereco    String?
  observacoes String?
  ativo       Boolean  @default(true)
  criado_em   DateTime @default(now()) @db.Timestamptz(6)

  emprestimos Emprestimo[]

  @@map("emp_clientes")
}

model Emprestimo {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id      String    @db.Uuid
  valor           Decimal   @db.Decimal(12, 2)
  taxa_juros      Decimal   @db.Decimal(5, 2)
  data_inicio     DateTime  @db.Date
  data_vencimento DateTime? @db.Date
  status          String    @default("ativo")
  observacoes     String?
  criado_em       DateTime  @default(now()) @db.Timestamptz(6)

  cliente    Cliente     @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  pagamentos Pagamento[]

  @@map("emp_emprestimos")
}

model Pagamento {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  emprestimo_id  String   @db.Uuid
  valor          Decimal  @db.Decimal(12, 2)
  data_pagamento DateTime @db.Date
  tipo           String
  observacoes    String?
  criado_em      DateTime @default(now()) @db.Timestamptz(6)

  emprestimo Emprestimo @relation(fields: [emprestimo_id], references: [id], onDelete: Cascade)

  @@map("emp_pagamentos")
}
